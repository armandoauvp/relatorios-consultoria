balho","pagina":3,"exemplo":"Um dado curto.","tipo":"longo","dica":"Atua como X, sob vínculo de trabalho do tipo CLT / PJ / estatutário-servidor público / empresário-sócio / autônomo / comissionado, com renda mensal de R$ X, gastos de R$ X e capacidade de aportar R$ X. Se o cliente não vai aportar e vai trabalhar apenas com a liquidez que já tem, deixar isso explícito;"},"contexto_consideracoes":{"rotulo":"Contexto consideracoes","pagina":3,"exemplo":"Um dado curto.","tipo":"longo","dica":"Demais considerações relevantes sobre o cliente: viés com determinados setores, nível de conhecimento em cada classe de ativo, necessidade de caixa para um objetivo próximo, existência e alocação atual da reserva de emergência;"},"objetivo_mestre_texto":{"rotulo":"Objetivo mestre texto","pagina":3,"exemplo":"Dois ou três parágrafos.","tipo":"longo","dica":"Objetivo Mestre (em geral, liberdade financeira ou renda passiva a partir de determinado prazo)"},"objetivos_secundarios_texto":{"rotulo":"Objetivos secundarios texto","pagina":3,"exemplo":"Dois ou três parágrafos.","tipo":"longo","dica":"Objetivos Secundários (troca de carro, entrada de imóvel, viagem, curso) — ser detalhista, é o que prova que o relatório não é padronizado"},"pat_financeiro_valor":{"rotulo":"Pat financeiro valor","pagina":3,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"pat_financeiro_dist":{"rotulo":"Pat financeiro dist","pagina":3,"exemplo":"12,4%","tipo":"percentual"},"pat_imobilizado_valor":{"rotulo":"Pat imobilizado valor","pagina":3,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"pat_imobilizado_dist":{"rotulo":"Pat imobilizado dist","pagina":3,"exemplo":"12,4%","tipo":"percentual"},"pat_liquidez_valor":{"rotulo":"Pat liquidez valor","pagina":3,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"pat_liquidez_dist":{"rotulo":"Pat liquidez dist","pagina":3,"exemplo":"12,4%","tipo":"percentual"},"cenario_carteira":{"rotulo":"Cenario carteira","pagina":5,"exemplo":"Pulverizada","tipo":"opcoes","opcoes":"cenario","dica":"Os textos a seguir são a base do diagnóstico macro da carteira. Todo cliente se enquadra em um dos quatro cenários — pulverizada, concentrada, equilibrada ou em liquidez. Fica apenas o texto do cenário escolhido aqui. Este tópico é só o retrato macro: a análise classe por classe vem na seção 3."},"comentario_carteira":{"rotulo":"Comentario carteira","pagina":10,"exemplo":"Um dado curto.","tipo":"longo","dica":"Inserir comentários gerais sobre a carteira, como aderência ao perfil de risco e aos objetivos informados no suitability. Valide também o que já está bem feito: se o cliente tem bons ativos na carteira, elogie explicitamente antes de entrar nos pontos de ajuste."},"comparacao_1_classe":{"rotulo":"Comparacao 1 classe","pagina":10,"exemplo":"Renda fixa pós-fixada","tipo":"opcoes","opcoes":"classe","dica":"[classe]"},"comparacao_1_atual":{"rotulo":"Comparacao 1 atual","pagina":10,"exemplo":"R$ 128.400,00","dica":"[x%]"},"comparacao_1_meta":{"rotulo":"Comparacao 1 meta","pagina":10,"exemplo":"12,4%","tipo":"percentual","dica":"[y%]"},"comparacao_2_classe":{"rotulo":"Comparacao 2 classe","pagina":10,"exemplo":"Renda fixa pós-fixada","tipo":"opcoes","opcoes":"classe","dica":"[classe]"},"comparacao_2_atual":{"rotulo":"Comparacao 2 atual","pagina":10,"exemplo":"R$ 128.400,00","dica":"[x%]"},"comparacao_2_meta":{"rotulo":"Comparacao 2 meta","pagina":10,"exemplo":"12,4%","tipo":"percentual","dica":"[y%]"},"comparacao_redirecionamento":{"rotulo":"Comparacao redirecionamento","pagina":10,"exemplo":"Um dado curto.","dica":"Opcional: e pelo redirecionamento dos vencimentos de renda fixa a partir de [data]"},"comparacao_venda":{"rotulo":"Comparacao venda","pagina":10,"exemplo":"Um dado curto.","dica":"Ou: com venda parcial e gradual apenas de [ativo], pelo motivo descrito adiante","padrao":"sem necessidade de vender"},"comparacao_mantidas":{"rotulo":"Comparacao mantidas","pagina":10,"exemplo":"Um dado curto.","dica":"[ativos/classes]"},"valor_renda_passiva":{"rotulo":"Valor renda passiva","pagina":11,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"valor_patrimonio_necessario":{"rotulo":"Valor patrimonio necessario","pagina":11,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"valor_patrimonio_inicial":{"rotulo":"Valor patrimonio inicial","pagina":11,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"valor_aporte_mensal":{"rotulo":"Valor aporte mensal","pagina":11,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"qtd_meses_objetivo":{"rotulo":"Qtd meses objetivo","pagina":11,"exemplo":"135.420","tipo":"numero","dica":"N"},"valor_reserva_emergencia":{"rotulo":"Valor reserva emergencia","pagina":11,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"protecao_gatilho_texto":{"rotulo":"Protecao gatilho texto","pagina":12,"exemplo":"Dois ou três parágrafos.","tipo":"longo","dica":"Inserir gatilho identificado no KYC, por exemplo: casamento previsto para, filho(a) de [idade], dependentes financeiros"},"protecao_seguro_texto":{"rotulo":"Protecao seguro texto","pagina":12,"exemplo":"Dois ou três parágrafos.","tipo":"longo","dica":"Se aplicável: hoje, na ausência de um seguro de vida vigente / com o seguro de vida atual, no valor de capital segurado de R$ [valor]"},"pgbl_situacao":{"rotulo":"Pgbl situacao","pagina":12,"exemplo":"Em andamento","dica":"não está sendo utilizado / está sendo utilizado parcialmente"},"valor_renda_mensal":{"rotulo":"Valor renda mensal","pagina":12,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"protecao_recomendacao":{"rotulo":"Protecao recomendacao","pagina":12,"exemplo":"Uma ou duas frases.","tipo":"longo","dica":"Preencher — priorizar seguro de vida temporário com capital segurado de R$ [x] / priorizar previdência PGBL como veículo de acumulação com benefício fiscal e função sucessória / combinar os dois instrumentos"},"rf_pre_taxa":{"rotulo":"Rf pre taxa","pagina":13,"exemplo":"CDI + 2,10%"},"rf_pre_valor_atual":{"rotulo":"Rf pre valor atual","pagina":13,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"rf_pre_perc":{"rotulo":"Rf pre perc","pagina":13,"exemplo":"12,4%","tipo":"percentual"},"rf_ipca_taxa":{"rotulo":"Rf ipca taxa","pagina":13,"exemplo":"CDI + 2,10%"},"rf_ipca_valor_atual":{"rotulo":"Rf ipca valor atual","pagina":13,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"rf_ipca_perc":{"rotulo":"Rf ipca perc","pagina":13,"exemplo":"12,4%","tipo":"percentual"},"rf_pcdi_taxa":{"rotulo":"Rf pcdi taxa","pagina":13,"exemplo":"CDI + 2,10%"},"rf_pcdi_valor_atual":{"rotulo":"Rf pcdi valor atual","pagina":13,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"rf_pcdi_perc":{"rotulo":"Rf pcdi perc","pagina":13,"exemplo":"12,4%","tipo":"percentual"},"rf_cdimais_taxa":{"rotulo":"Rf cdimais taxa","pagina":13,"exemplo":"CDI + 2,10%"},"rf_cdimais_valor_atual":{"rotulo":"Rf cdimais valor atual","pagina":13,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"rf_cdimais_perc":{"rotulo":"Rf cdimais perc","pagina":13,"exemplo":"12,4%","tipo":"percentual"},"rf_selic_taxa":{"rotulo":"Rf selic taxa","pagina":13,"exemplo":"CDI + 2,10%"},"rf_selic_valor_atual":{"rotulo":"Rf selic valor atual","pagina":13,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"rf_selic_perc":{"rotulo":"Rf selic perc","pagina":13,"exemplo":"12,4%","tipo":"percentual"},"comentario_rf":{"rotulo":"Comentario rf","pagina":14,"exemplo":"CDB Banco BTG 2029","tipo":"longo","dica":"Inserir comentários sobre a carteira de renda fixa do cliente: taxas por indexador, concentração em emissores, liquidez da carteira e o que será trabalhado na consultoria. Pontos de atenção a levantar: risco de crédito do emissor, teto do FGC (R$250 mil) e vencimentos pré-fixados muito longos. Complemente com o cenário doméstico atual e o que pode impactar a curva de juros futura. Não misture aqui fundos de liquidez nem ETFs de renda fixa (ex.: AUPO11, LFTB11) — eles têm espaço próprio na seção de fundos. Se o cliente não tem exposição a algum indexador, remova a linha da tabela em vez de deixá-la zerada."},"comentario_acoes":{"rotulo":"Comentario acoes","pagina":16,"exemplo":"Um dado curto.","tipo":"longo","dica":"Inserir comentários sobre a carteira de ações: concentração em ativos e setores e o que será trabalhado na consultoria. Deixe claro, para cada ativo, qual dos três destinos ele segue, mantido, aportes congelados ou avaliado para venda, com o racional correspondente, inclusive para os congelados. Os três únicos casos que justificam venda, a checagem prévia com o time de análise e a avaliação tributária obrigatória estão no playbook da R3 (§4.7). Registre no relatório que o custo tributário foi considerado."},"comentario_fii":{"rotulo":"Comentario fii","pagina":18,"exemplo":"HGLG11","tipo":"longo","dica":"Inserir comentários sobre a carteira de FIIs: concentração por ativo e segmento e o que será trabalhado na consultoria. Mesma lógica das ações — destino explícito de cada ativo, racional individual por venda e checagem prévia com o time de análise (playbook da R3, §4.8). Atenção: o limite mensal de isenção de IR para vendas não se aplica a FIIs."},"comentario_intl":{"rotulo":"Comentario intl","pagina":20,"exemplo":"IVVB11","tipo":"longo","dica":"Inserir comentários sobre a carteira internacional: concentração por ativo e segmento e o que será trabalhado na consultoria. No exterior é comum encontrar sobreposição que parece diversificação e não é (ex.: IVV, SPY e VOO, que seguem o mesmo S&P 500) — quando ocorrer, comente por escrito e demonstre visualmente. Não venda um ETF que o cliente já tem só para comprar o equivalente oficial da casa: a lista de equivalentes validados e o critério de quando adotar o modelo UCITS estão no Manual da Carteira Internacional. Apoio: ETF Research Center — Fund Overlap."},"fundos_perc_taxa_adm":{"rotulo":"Fundos perc taxa adm","pagina":25,"exemplo":"12,4%","tipo":"percentual","dica":"N%"},"fundos_custo_anual":{"rotulo":"Fundos custo anual","pagina":25,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"perf_1_benchmark":{"rotulo":"Perf 1 benchmark","pagina":25,"exemplo":"Um dado curto.","dica":"Ex.: 100% do CDI"},"perf_1_taxa":{"rotulo":"Perf 1 taxa","pagina":25,"exemplo":"12,4%","tipo":"percentual"},"perf_1_valor":{"rotulo":"Perf 1 valor","pagina":25,"exemplo":"R$ 128.400,00","tipo":"dinheiro"},"perf_1_perc":{"rotulo":"Perf 1 perc","pagina":25,"exemplo":"12,4%","tipo":"percentual"},"comentario_fundos":{"rotulo":"Comentario fundos","pagina":25,"exemplo":"Um dado curto.","tipo":"longo","dica":"Compare cada fundo com o seu benchmark (CDI, Ibovespa, IMA-B, conforme o tipo) e escreva a recomendação: resgate com exposição direta nos ativos subjacentes ou portabilidade para fundo de taxas mais baixas, no caso de previdência privada. Os dois únicos casos em que recomendamos previdência estão no playbook da R2 (§5)."},"entrada_percentual":{"rotulo":"Entrada percentual","pagina":29,"exemplo":"Um dado curto.","dica":"Balizador, não trava: a decisão final é do consultor, conforme perfil, objetivos e momento de mercado, desde que o racional seja explicado e registrado no relatório. Os exemplos de cálculo, os ajustes finos e o tratamento de cliente sem aporte recorrente estão no playbook da R3 (§5.3). [x%]"},"entrada_aportes":{"rotulo":"Entrada aportes","pagina":29,"exemplo":"R$ 128.400,00","tipo":"dinheiro","dica":"[nº]"},"entrada_frequencia":{"rotulo":"Entrada frequencia","pagina":29,"exemplo":"Um dado curto.","dica":"[quinzenais/mensais]"},"entrada_veiculo":{"rotulo":"Entrada veiculo","pagina":29,"exemplo":"Um dado curto.","dica":"[veículo de liquidez]"},"rf_pre_valor":{"rotulo":"Rf pre valor","pagina":29,"exemplo":"R$ 128.400,00","tipo":"dinheiro","dica":"Monte estas tabelas a partir do diagrama do cerrado (Jamel Street)."},"rf_ipca_valor":{"rotulo":"Rf ipca valor","pagina":29,"exemplo":"R$ 128.400,00","tipo":"dinheiro","dica":"Monte estas tabelas a partir do diagrama do cerrado (Jamel Street)."},"rf_pos_valor":{"rotulo":"Rf pos valor","pagina":29,"exemplo":"R$ 128.400,00","tipo":"dinheiro","dica":"Monte estas tabelas a partir do diagrama do cerrado (Jamel Street)."},"rf_liquidez_valo